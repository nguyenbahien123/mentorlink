#!/bin/bash

# ============ Database Configuration ============
DATABASE_PASSWORD=your_secure_mysql_password_here
DB_PORT=3306

# ============ Backend Configuration ============
BACKEND_PORT=8080

# ============ Frontend Configuration ============
FRONTEND_PORT=80

# ============ Cloudinary Configuration ============
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============ JWT Configuration ============
JWT_ACCESS_KEY=your_jwt_access_key_here_minimum_256_bits
JWT_REFRESH_KEY=your_jwt_refresh_key_here_minimum_256_bits
JWT_RESET_KEY=your_jwt_reset_key_here_minimum_256_bits
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_256_bits

# ============ Email Configuration (Brevo/Sendinblue) ============
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_password_or_app_password
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@yourcompany.com
BREVO_SENDER_NAME=MentorLink

# ============ PayOS Configuration ============
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=https://yourdomain.com/booking/callback
PAYOS_CANCEL_URL=https://yourdomain.com/find-mentor?bookingSuccess=false

# ============ AI/Vector Database Configuration (Optional) ============
# Qdrant Configuration
QDRANT_HOST=api.qdrant.cloud
QDRANT_PORT=443
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_TLS=true

# Google Generative AI (Gemini) Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
