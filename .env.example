# ⚠️ INSTRUCTIONS: Copy this file to .env and fill in REAL VALUES
# ⚠️ IMPORTANT: DO NOT commit .env to git - it contains secrets
# ⚠️ Make sure .env is in .gitignore

# ===== DATABASE CONFIG =====
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=changeme_with_strong_password

# ===== FRONTEND CONFIG =====
# For local development: http://localhost:8080
# For Docker/production with nginx reverse proxy: "" (empty string - endpoints already have /api/ prefix)
# NOTE: All API endpoints already include /api/ prefix (e.g., /api/auth/login)
VITE_API_URL=http://localhost:8080

# ===== EMAIL (Brevo/Sendinblue) =====
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_SENDER_NAME=MentorLink

# ===== JWT KEYS (use secure random values) =====
JWT_ACCESS_KEY=base64_encoded_random_key_here
JWT_REFRESH_KEY=base64_encoded_random_key_here
JWT_RESET_KEY=base64_encoded_random_key_here
JWT_SECRET_KEY=random_secret_key_here

# ===== CLOUDINARY (Image Upload) =====
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== PAYOS (Payment Gateway) =====
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:8080/api/bookings/payos-return
PAYOS_CANCEL_URL=http://localhost:3000/find-mentor?bookingSuccess=false

# ===== OPTIONAL: VNPay (Deprecated - use PayOS instead) =====
# VNPAY_TMN_CODE=your_vnpay_tmncode
# VNPAY_HASH_SECRET=your_vnpay_hash_secret
