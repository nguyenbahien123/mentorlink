# Copy this file to .env and fill in real values. DO NOT commit .env

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=changeme

# Brevo Email Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_SENDER_NAME=MentorLink

# JWT (use secure random values in production)
JWT_ACCESS_KEY=
JWT_REFRESH_KEY=
JWT_RESET_KEY=
JWT_SECRET_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8080/api/bookings/payos-return
PAYOS_CANCEL_URL=http://localhost:3000/find-mentor?bookingSuccess=false
#!/bin/bash

# Environment variables for MentorLink Configuration
# Add these to your system environment or .env file

# PayOS Payment Gateway Configuration
export PAYOS_CLIENT_ID="your_payos_client_id_here"
export PAYOS_API_KEY="your_payos_api_key_here"
export PAYOS_CHECKSUM_KEY="your_payos_checksum_key_here"
# Optional: Override default return/cancel URLs
# export PAYOS_RETURN_URL="http://localhost:8080/api/bookings/payos-return"
# export PAYOS_CANCEL_URL="http://localhost:3000/find-mentor?bookingSuccess=false"

echo "Environment variables set successfully!"
