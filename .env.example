#!/bin/bash

# Environment variables for MentorLink Chatbot Integration
# Add these to your system environment or .env file

# Qdrant Configuration
export QDRANT_HOST="api.qdrant.cloud"
export QDRANT_PORT="443"
export QDRANT_API_KEY="your_qdrant_api_key_here"
export QDRANT_TLS="true"

# Google Generative AI (Gemini) Configuration
export GEMINI_API_KEY="your_gemini_api_key_here"
export GEMINI_MODEL="gemini-1.5-flash"

echo "Environment variables set successfully!"
